diff --git a/src/nebaro.rs b/src/nebaro.rs
new file mode 100644
index 0000000..84731db
--- /dev/null
+++ b/src/nebaro.rs
@@ -0,0 +1,155 @@
+//! NEBARO Fernwartung: the configuration built into this client.
+//!
+//! Added by the NEBARO patch (AGPL-3.0, like RustDesk).
+//! It replaces the signed `custom.txt` of RustDesk's custom-client mechanism: the same maps
+//! (OVERWRITE_*, BUILTIN_SETTINGS, HARD_SETTINGS) are filled, but from this file at start, so
+//! nobody can change them on the customer's PC and no configuration file next to the program,
+//! no file name and no deep link is read.
+//!
+//! Server and key are not in this file: the build sets `NEBARO_RENDEZVOUS_SERVER` and
+//! `NEBARO_RS_PUB_KEY`, and the patched `hbb_common::config::RENDEZVOUS_SERVERS` / `RS_PUB_KEY`
+//! read them with `env!` (no build without them).
+
+use base::config::keys;
+use hbb_common::config::{self, RENDEZVOUS_SERVERS, RS_PUB_KEY};
+
+/// Name in window title, config folder and IPC path.
+pub const APP_NAME: &str = "NEBARO Fernwartung";
+
+/// `do_check_software_update` returns before any request to rustdesk.com: new versions come
+/// only from the NEBARO build.
+pub const NO_UPDATE_CHECK: bool = true;
+
+/// `platform::windows::get_license_from_exe_name` returns an error: server and key never come
+/// from the file name of the program.
+pub const NO_EXE_NAME_CONFIG: bool = true;
+
+/// Never fall back to an unencrypted session. RustDesk continues in plain text when the peer's
+/// key is not signed by the server key it knows (client: `Client::secure_connection`, server:
+/// `server::identity_handshake`). With this switch both sides break off instead
+/// (client: `Client::secure_connection`, `io_loop`; server: `server::create_tcp_connection`).
+pub const REFUSE_INSECURE: bool = true;
+
+/// Shown in the window when a session is refused because it would not be encrypted.
+pub const INSECURE_REFUSED: &str = "Connection refused: encryption could not be verified, the \
+peer's key is not confirmed by the NEBARO server. Please contact NEBARO support.";
+
+/// Server side of a session: what the technician may do on this PC.
+const OVERRIDE_SETTINGS: &[(&str, &str)] = &[
+    // Own server and key (set in apply()), the user cannot change them.
+    (keys::OPTION_API_SERVER, ""),
+    // "custom": every permission below counts; "full" would switch all of them on.
+    (keys::OPTION_ACCESS_MODE, "custom"),
+    // Screen, mouse and keyboard: that is the support session.
+    (keys::OPTION_ENABLE_KEYBOARD, "Y"),
+    // Clipboard stays on. Files over the clipboard need file transfer
+    // (Connection::can_sub_file_clipboard_service, Cliprdr handling), so only text and images go.
+    (keys::OPTION_ENABLE_CLIPBOARD, "Y"),
+    // No file transfer.
+    (keys::OPTION_ENABLE_FILE_TRANSFER, "N"),
+    // Everything else a support session does not need.
+    (keys::OPTION_ENABLE_CAMERA, "N"),
+    (keys::OPTION_ENABLE_TERMINAL, "N"),
+    (keys::OPTION_ENABLE_REMOTE_PRINTER, "N"),
+    (keys::OPTION_ENABLE_AUDIO, "N"),
+    (keys::OPTION_ENABLE_TUNNEL, "N"),
+    (keys::OPTION_ENABLE_REMOTE_RESTART, "N"),
+    (keys::OPTION_ENABLE_RECORD_SESSION, "N"),
+    (keys::OPTION_ENABLE_BLOCK_INPUT, "N"),
+    (keys::OPTION_ENABLE_PRIVACY_MODE, "N"),
+    (keys::OPTION_ALLOW_REMOTE_CONFIG_MODIFICATION, "N"),
+    (keys::OPTION_ALLOW_AUTO_RECORD_INCOMING, "N"),
+    (keys::OPTION_ENABLE_TRUSTED_DEVICES, "N"),
+    // Only through the NEBARO server: no direct port, no LAN discovery, no WebSocket.
+    (keys::OPTION_DIRECT_SERVER, "N"),
+    (keys::OPTION_ENABLE_LAN_DISCOVERY, "N"),
+    (keys::OPTION_ALLOW_WEBSOCKET, "N"),
+    // Only while the window is open: nothing accepts sessions after closing.
+    (keys::OPTION_ALLOW_ONLY_CONN_WINDOW_OPEN, "Y"),
+    // Acceptance: never a fixed password. Without a password the user clicks "Accept" on the
+    // device; alternatively the one-time password shown in the window is accepted.
+    // "password-click" = both, the same value RustDesk uses for its custom clients.
+    (keys::OPTION_APPROVE_MODE, "password-click"),
+    (keys::OPTION_VERIFICATION_METHOD, "use-temporary-password"),
+    (keys::OPTION_TEMPORARY_PASSWORD_LENGTH, "8"),
+    (keys::OPTION_ALLOW_NUMERNIC_ONE_TIME_PASSWORD, "N"),
+    // No update from rustdesk.com (see NO_UPDATE_CHECK).
+    (keys::OPTION_ALLOW_AUTO_UPDATE, "N"),
+];
+
+/// Local (controlling side and UI) settings.
+const OVERRIDE_LOCAL_SETTINGS: &[(&str, &str)] = &[
+    (keys::OPTION_ENABLE_CHECK_UPDATE, "N"),
+    (keys::OPTION_ENABLE_UDP_PUNCH, "N"),
+    (keys::OPTION_ENABLE_IPV6_PUNCH, "N"),
+    (keys::OPTION_ENABLE_TCP_PUNCH, "N"),
+    (keys::OPTION_ENABLE_WEBRTC, "N"),
+    (keys::OPTION_PRE_ELEVATE_SERVICE, "N"),
+    (keys::OPTION_ALLOW_REMOTE_CM_MODIFICATION, "N"),
+];
+
+/// Built-in options (RustDesk reads them from BUILTIN_SETTINGS).
+const BUILTIN_SETTINGS: &[(&str, &str)] = &[
+    // No heartbeat to an API server (Config::no_register_device): the free server has none.
+    (keys::OPTION_REGISTER_DEVICE, "N"),
+    (keys::OPTION_DISABLE_CHANGE_PERMANENT_PASSWORD, "Y"),
+    (keys::OPTION_DISABLE_CHANGE_ID, "Y"),
+    (keys::OPTION_ALLOW_LOGON_SCREEN_PASSWORD, "N"),
+    (keys::OPTION_ALLOW_DEEP_LINK_PASSWORD, "N"),
+    (keys::OPTION_ALLOW_DEEP_LINK_SERVER_SETTINGS, "N"),
+    (keys::OPTION_ALLOW_HOSTNAME_AS_ID, "N"),
+    (keys::OPTION_ENABLE_PERM_CHANGE_IN_ACCEPT_WINDOW, "N"),
+    (keys::OPTION_HIDE_SERVER_SETTINGS, "Y"),
+    (keys::OPTION_HIDE_PROXY_SETTINGS, "Y"),
+    (keys::OPTION_HIDE_SECURITY_SETTINGS, "Y"),
+    (keys::OPTION_HIDE_NETWORK_SETTINGS, "Y"),
+    (keys::OPTION_HIDE_WEBSOCKET_SETTINGS, "Y"),
+    (keys::OPTION_HIDE_REMOTE_PRINTER_SETTINGS, "Y"),
+    (keys::OPTION_HIDE_STOP_SERVICE, "Y"),
+];
+
+/// Hard options (config::is_disable_* / is_incoming_only).
+const HARD_SETTINGS: &[(&str, &str)] = &[
+    // Only receive a session, never control another PC.
+    ("conn-type", "incoming"),
+    // No installation, no service, no autostart.
+    ("disable-installation", "Y"),
+    ("disable-settings", "Y"),
+    ("disable-ab", "Y"),
+    ("disable-account", "Y"),
+    // No listening port on the PC: only the NEBARO server.
+    ("disable-tcp-listen", "Y"),
+];
+
+/// Fills the configuration maps. Called by `common::load_custom_client` instead of reading
+/// `custom.txt`, in every process of the client (GUI, --server, --cm).
+pub fn apply() {
+    let host = RENDEZVOUS_SERVERS[0];
+    *config::APP_NAME.write().unwrap() = APP_NAME.to_owned();
+    #[cfg(target_os = "macos")]
+    {
+        *config::ORG.write().unwrap() = "at.nebaro".to_owned();
+    }
+    {
+        let mut m = config::OVERWRITE_SETTINGS.write().unwrap();
+        m.insert(keys::OPTION_CUSTOM_RENDEZVOUS_SERVER.to_owned(), host.to_owned());
+        m.insert(keys::OPTION_RELAY_SERVER.to_owned(), host.to_owned());
+        m.insert(keys::OPTION_KEY.to_owned(), RS_PUB_KEY.to_owned());
+        for (k, v) in OVERRIDE_SETTINGS {
+            m.insert((*k).to_owned(), (*v).to_owned());
+        }
+    }
+    fill(&config::OVERWRITE_LOCAL_SETTINGS, OVERRIDE_LOCAL_SETTINGS);
+    fill(&config::BUILTIN_SETTINGS, BUILTIN_SETTINGS);
+    fill(&config::HARD_SETTINGS, HARD_SETTINGS);
+}
+
+fn fill(
+    map: &std::sync::RwLock<std::collections::HashMap<String, String>>,
+    entries: &[(&str, &str)],
+) {
+    let mut m = map.write().unwrap();
+    for (k, v) in entries {
+        m.insert((*k).to_owned(), (*v).to_owned());
+    }
+}
